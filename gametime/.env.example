# Copy to .env (setup.sh does this interactively). Never commit .env.
UNIFI_HOST=https://192.168.0.1
UNIFI_API_KEY=                 # console: Settings -> Control Plane -> Integrations -> Create API key
UNIFI_SITE=default
PARENT_PIN=                    # what the parent types on /parent
SECRET=                        # random hex; signs the parent login cookie
PUBLIC_URL=http://192.168.0.190:8085   # used in notification links
NTFY_URL=                      # optional: https://ntfy.sh/<private-topic> -> push to the ntfy phone app
MAX_MINUTES=240                # hard cap per grant
# UNIFI_MOCK=1                 # demo with pretend policies, touches nothing
