# Copy to .env and fill in real values (setup.sh generates this for you).
# .env is gitignored — never commit it (this repo is public).

# Immich-managed originals (phone uploads etc.) — under /srv/data so the
# wholesale /srv/data backup covers them
UPLOAD_LOCATION=/srv/data/immich

# regenerable app state
DB_DATA_LOCATION=/srv/immich/postgres

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=changeme

IMMICH_VERSION=release
